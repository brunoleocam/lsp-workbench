## 🚀 **Exemplos Práticos**

### **Validação de CPF**
```lsp
Definir Funcao validarCPF();
Definir Alfa vaCPF;
Definir Numero vnTamanho;
Definir Alfa vaCPFNumeros;

vaCPF = "123.456.789-10";
validarCPF();

Funcao validarCPF(); {
  @ Copia CPF para não alterar original @
  vaCPFNumeros = vaCPF;
  
  @ Remove formatação @
  DeixaNumeros(vaCPFNumeros);
  
  @ Verifica tamanho @
  TamanhoAlfa(vaCPFNumeros, vnTamanho);
  Se (vnTamanho <> 11) {
    Mensagem(Erro, "CPF deve ter 11 dígitos");
    Cancel(1);
  }
  
  Mensagem(Retorna, "CPF válido!");
};
```

### **Consulta CEP via API**
```lsp
Definir Funcao consultarCEP();
Definir Alfa vaCEP;
Definir Alfa vaURL;
Definir Alfa vaHTTP;
Definir Alfa vaResposta;
Definir Alfa vaEndereco;

vaCEP = "01310-100";
consultarCEP();

Funcao consultarCEP(); {
  @ Remove formatação do CEP @
  DeixaNumeros(vaCEP);
  
  @ Monta URL @
  vaURL = "https://viacep.com.br/ws/" + vaCEP + "/json/";
  
  @ Faz requisição @
  HttpObjeto(vaHTTP);
  HttpGet(vaHTTP, vaURL, vaResposta);
  
  @ Extrai dados @
  ValorElementoJson(vaResposta, "", "logradouro", vaEndereco);
  
  Mensagem(Retorna, "Endereço: " + vaEndereco);
};
```

### **Processamento de Arquivo com Barra de Progresso**
```lsp
Definir Funcao processarArquivo();
Definir Numero vnArquivo;
Definir Numero vnLinhas;
Definir Numero vnContador;
Definir Alfa vaLinha;
Definir Numero vnPercentual;

processarArquivo();

Funcao processarArquivo(); {
  @ Conta linhas do arquivo @
  LinhasArquivo("dados.txt", vnLinhas);
  
  @ Inicia barra de progresso @
  IniciaBarraProgresso("Processando Arquivo", "Iniciando...");
  
  @ Abre arquivo @
  vnArquivo = Abrir("dados.txt", "Ler");
  
  @ Processa cada linha @
  Para (vnContador = 1; vnContador <= vnLinhas; vnContador++) {
    Lernl(vnArquivo, vaLinha);
    
    @ Calcula percentual @
    vnPercentual = (vnContador * 100) / vnLinhas;
    
    @ Atualiza barra @
    AtualizaBarraProgresso(vnPercentual, "Processando linha " + vnContador);
    
    @ Processa linha @
    @ ... @
  }
  
  @ Finaliza @
  Fechar(vnArquivo);
  FinalizaBarraProgresso();
};
```

### **Exemplo de Definição de Função**
```lsp
@ Definição de função com parâmetros @
Definir Funcao calcularDesconto(Numero pnValor, Numero pnPercentual, Numero End pnDesconto);

@ Uso da função @
Definir Numero vnValorOriginal;
Definir Numero vnPercentualDesconto;
Definir Numero vnDescontoCalculado;

vnValorOriginal = 100;
vnPercentualDesconto = 15;

calcularDesconto(vnValorOriginal, vnPercentualDesconto, vnDescontoCalculado);

@ Definição da função @
Funcao calcularDesconto(Numero pnValor, Numero pnPercentual, Numero End pnDesconto); {
  pnDesconto = (pnValor * pnPercentual) / 100;
};
```

