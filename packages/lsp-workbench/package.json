{
  "name": "lsp-workbench",
  "displayName": "LSP Workbench",
  "description": "Linguagem Senior de Programação (LSP): syntax highlighting, snippets, autocomplete, hover, formatação e validação para Senior Sistemas / Sapiens / HCM.",
  "version": "0.2.3",
  "publisher": "brunoleocam",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brunoleocam/lsp-workbench.git"
  },
  "homepage": "https://github.com/brunoleocam/lsp-workbench",
  "bugs": {
    "url": "https://github.com/brunoleocam/lsp-workbench/issues"
  },
  "keywords": [
    "Linguagem Senior de Programação LSP",
    "linguagem senior",
    "senior",
    "senior sistemas",
    "sapiens",
    "hcm",
    "lsp",
    "snippet",
    "snippets",
    "syntax highlighting",
    "formatter",
    "autocomplete",
    "erp"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters",
    "Snippets"
  ],
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:senior-lsp",
    "onCommand:lspWorkbench.createContext",
    "onCommand:lspWorkbench.editContext",
    "onCommand:lspWorkbench.removeContext",
    "onCommand:lspWorkbench.addToContext",
    "onCommand:lspWorkbench.removeFromContext",
    "onCommand:lspWorkbench.toggleSymbolScope",
    "onCommand:lspWorkbench.selectFallbackSystem",
    "onCommand:lspWorkbench.gerarRelatorio",
    "onCommand:lspWorkbench.copiarRegraRelatorio",
    "onCommand:lspWorkbench.importarContextoDe",
    "onCommand:lspWorkbench.exportarContextoPara",
    "onCommand:lspWorkbench.mostrarEscopoRelatorio",
    "onCommand:lspWorkbench.exportarRelatorioMultiTrecho",
    "onCommand:lspWorkbench.importarRelatorio"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "[senior-lsp]": {
        "editor.wordBasedSuggestions": "off",
        "editor.inlineSuggest.enabled": false,
        "editor.suggest.showWords": false,
        "editor.snippetSuggestions": "inline",
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": false
        }
      }
    },
    "languages": [
      {
        "id": "senior-lsp",
        "aliases": [
          "Linguagem Senior",
          "LSP Workbench",
          "Senior LSP"
        ],
        "extensions": [
          ".lsp",
          ".lspt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "senior-lsp",
        "scopeName": "source.senior-lsp",
        "path": "./syntaxes/lsp.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "senior-lsp",
        "scopes": {
          "macro": [
            "keyword.control.flow.lsp"
          ]
        }
      }
    ],
    "themes": [
      {
        "label": "LSP Workbench (Clássico)",
        "uiTheme": "vs",
        "path": "./themes/lsp-workbench-classic-color-theme.json"
      },
      {
        "label": "LSP Workbench (Dark)",
        "uiTheme": "vs-dark",
        "path": "./themes/lsp-workbench-dark-color-theme.json"
      },
      {
        "label": "LSP Workbench (Full Dark)",
        "uiTheme": "vs-dark",
        "path": "./themes/lsp-workbench-fulldark-color-theme.json"
      }
    ],
    "snippets": [
      {
        "language": "senior-lsp",
        "path": "./snippets/lsp.json"
      }
    ],
    "configuration": {
      "title": "LSP Workbench",
      "properties": {
        "lsp.format.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Habilita formatação de documentos LSP."
        },
        "lsp.format.indentSize": {
          "type": "number",
          "default": 2,
          "enum": [
            2,
            4
          ],
          "description": "Tamanho da indentação."
        },
        "lsp.format.useTabs": {
          "type": "boolean",
          "default": false
        },
        "lsp.format.maxParamsPerLine": {
          "type": "number",
          "default": 4
        },
        "lsp.format.braceStyle": {
          "type": "string",
          "default": "sameLine",
          "enum": [
            "sameLine",
            "nextLine"
          ]
        },
        "lsp.format.embeddedSql.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Formatação dedicada de SQL embutido em ExecSql / .SQL / SQL_DefinirComando (PDR-004)."
        },
        "lsp.format.embeddedSql.dialect": {
          "type": "string",
          "default": "sql",
          "enum": [
            "sql",
            "oracle",
            "sqlserver"
          ],
          "description": "Dialeto pretendido para SQL embutido (heurística de layout)."
        },
        "lsp.refactor.defaultBlockStyle": {
          "type": "string",
          "default": "braces",
          "enum": [
            "braces",
            "inicioFim"
          ]
        },
        "lsp.diagnostics.ignoreIds": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "lsp.symbols.scope": {
          "type": "string",
          "default": "project",
          "enum": [
            "project",
            "file",
            "mixed"
          ],
          "enumDescriptions": [
            "Índice = workspace (ou contextos nomeados, se configurados)",
            "Apenas o arquivo atual (SingleFile)",
            "Arquivo atual + contextos em lsp.contexts (isolamento por contexto)"
          ],
          "description": "Escopo de símbolos / completion cross-file (PDR-003)."
        },
        "lsp.contexts": {
          "type": "array",
          "default": [],
          "description": "Contextos nomeados de validação/símbolos (pastas, padrões, sistema adicional).",
          "items": {
            "type": "object",
            "required": [
              "name",
              "rootDir",
              "filePattern"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "rootDir": {
                "type": "string"
              },
              "filePattern": {
                "type": "string"
              },
              "includeSubdirectories": {
                "type": "boolean",
                "default": true
              },
              "system": {
                "type": "string",
                "enum": [
                  "HCM",
                  "ACESSO",
                  "ERP"
                ],
                "description": "Sistema adicional (status/UI). Catálogo de builtins por sistema ainda não disponível — só SENIOR."
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Allowlist adicional (união com filePattern), caminhos relativos ao workspace."
              },
              "diagnostics": {
                "type": "object",
                "properties": {
                  "ignoreIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "IDs ignorados neste contexto (unidos a lsp.diagnostics.ignoreIds)."
                  }
                }
              }
            }
          }
        },
        "lsp.fallback.defaultSystem": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "HCM",
            "ACESSO",
            "ERP"
          ],
          "description": "Sistema adicional no SingleFile / modo arquivo (status bar). Catálogo por sistema ainda não implementado — builtins = SENIOR."
        },
        "lsp.semantic.embeddedSqlHighlight.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Highlight de SQL embutido em strings (keywords SELECT/FROM/…, funções TO_DATE/COUNT/…, binds :nome). Entregue via TextMate; o valor fica documentado para compatibilidade."
        },
        "lsp.server.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Usa o Language Server + Worker (Opção 3) para diagnósticos do analyzer. Desligado por padrão mantém diagnósticos in-process (Opção 1). Recarregue a janela após alterar."
        },
        "lsp.catalog.path": {
          "type": "string",
          "default": "",
          "description": "Path do catálogo local de tabelas (JSON). Vazio = tenta docs/banco-senior/.generated/catalog.json e depois docs/banco-senior-base/.generated/catalog.json (PDR-009). Ausente = completion de tabelas no-op."
        },
        "lsp.demobile.catalogPath": {
          "type": "string",
          "default": "",
          "description": "Deprecated: use lsp.catalog.path.",
          "deprecationMessage": "Use lsp.catalog.path instead."
        }
      }
    },
    "commands": [
      {
        "command": "lspWorkbench.createContext",
        "title": "LSP Workbench: Criar Contexto"
      },
      {
        "command": "lspWorkbench.editContext",
        "title": "LSP Workbench: Editar Contexto"
      },
      {
        "command": "lspWorkbench.removeContext",
        "title": "LSP Workbench: Apagar Contexto"
      },
      {
        "command": "lspWorkbench.addToContext",
        "title": "LSP Workbench: Adicionar ao Contexto"
      },
      {
        "command": "lspWorkbench.removeFromContext",
        "title": "LSP Workbench: Remover do Contexto"
      },
      {
        "command": "lspWorkbench.toggleSymbolScope",
        "title": "LSP Workbench: Alternar Escopo de Símbolos"
      },
      {
        "command": "lspWorkbench.selectFallbackSystem",
        "title": "LSP Workbench: Selecionar Sistema (Fallback)"
      },
      {
        "command": "lspWorkbench.gerarRelatorio",
        "title": "LSP Workbench: Gerar Projeto de Relatório"
      },
      {
        "command": "lspWorkbench.copiarRegraRelatorio",
        "title": "LSP Workbench: Copiar Regra do Relatório"
      },
      {
        "command": "lspWorkbench.exportarRelatorioMultiTrecho",
        "title": "LSP Workbench: Visualizar Todas as Regras"
      },
      {
        "command": "lspWorkbench.importarContextoDe",
        "title": "LSP Workbench: Importar Contexto de…"
      },
      {
        "command": "lspWorkbench.exportarContextoPara",
        "title": "LSP Workbench: Exportar Contexto para…"
      },
      {
        "command": "lspWorkbench.mostrarEscopoRelatorio",
        "title": "LSP Workbench: Mostrar Escopo do Relatório"
      },
      {
        "command": "lspWorkbench.importarRelatorio",
        "title": "LSP Workbench: Importar Relatório"
      }
    ]
  },
  "scripts": {
    "extract-functions": "node ../../scripts/extract-lsp-functions.mjs",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run extract-functions",
    "test": "npm run compile && node --test out/test/*.test.js",
    "compile:analyzer": "npm run compile --prefix ../lsp-analyzer",
    "vscode:prepublish": "npm run compile:analyzer && npm run extract-functions && npm run compile",
    "package:vsix": "node ../../scripts/package-extension.mjs"
  },
  "dependencies": {
    "@lsp-workbench/analyzer": "file:../lsp-analyzer",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
