{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run LSP Workbench Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/lsp-workbench",
        "${workspaceFolder}/packages/lsp-workbench/fixtures"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/lsp-workbench/out/**/*.js"
      ],
      "preLaunchTask": "npm: compile - lsp-workbench"
    }
  ]
}
